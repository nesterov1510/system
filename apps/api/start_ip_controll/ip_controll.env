# ==========================================================
# MSB — Start IP Control
# Управляет тем, на каком host/port поднимается сервер (uvicorn).
# Читается при запуске: python -m start_ip_controll
# ==========================================================

# --- На каком адресе слушать ---

# True  -> сервер доступен ТОЛЬКО локально на этом ПК: host=127.0.0.1
# False -> локальный режим не выбран.
MAIN_LOCAL_HOST=False

# True  -> слушать на всех IP сервера: host=0.0.0.0
#          Открывать через реальный IP сервера: http://192.168.8.81:8085
# False -> не слушать все IP (тогда действует белый список ниже или localhost).
MAIN_NA_VCEH_IP_START=True

##########################################################################

# --- Белый список IP/сетей сервера, на которых разрешён старт ---

# True  -> проверять, что IP самого сервера входит в список ниже.
# False -> список MAIN_KAKIYE_IP_RAZRESHEN_DLYA_START игнорируется.
MAIN_RAZRESHENNIYE_IP_PROVERKA=False

# Какие IP/сети сервера разрешены для старта (работает только если проверка
# выше = True). Поддерживается:
#   конкретный IP: 192.168.8.81
#   сеть CIDR:     192.168.8.0/24
MAIN_KAKIYE_IP_RAZRESHEN_DLYA_START=192.168.8.81, 192.168.8.0/24, 127.0.0.1

##########################################################################

# --- Порт запуска ---
# Боевой порт MSB.
MAIN_START_PORT=8085

##########################################################################
