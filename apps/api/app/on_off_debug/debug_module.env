# ==========================================================
# on_off_debug settings (портировано из архива 123.zip)
# ==========================================================

# App Identity — используется только для CRITICAL уведомлений
DEBUG_NAME_APP=msb_api
DEBUG_APP_IP=auto
DEBUG_APP_ENV=production
DEBUG_APP_INSTANCE=main

# Log levels
DEBUG_INFO_MODE=True
DEBUG_SUCCESS_MODE=True
DEBUG_SUCCESS1_MODE=True
DEBUG_WARNING_MODE=True
DEBUG_ERROR_MODE=True
DEBUG_ERROR1_MODE=True
DEBUG_CRITICAL_ERROR_MODE=True
DEBUG_UNICODE_MODE=True

# Production: False — быстрее, env перечитывается после restart сервиса
# Development: True — удобно менять настройки без restart
DEBUG_RELOAD_ENV_EACH_CALL=False

# HTTP request log — отдельный тумблер (не зависит от DEBUG_INFO_MODE)
DEBUG_HTTP_LOG_MODE=True
DEBUG_HTTP_CONSOLE=False

# Ротация лог-файлов по размеру
# DEBUG_MAX_FILE_KB — максимальный размер файла в КБ, после чего файл
#   переименовывается в *.1, *.2 и т.д.
# DEBUG_MAX_FILES — сколько ротированных копий хранить
DEBUG_MAX_FILE_KB=2048
DEBUG_MAX_FILES=5

# Logs folder
# Относительный путь = внутри on_off_debug/
# Абсолютный путь = например /var/log/my_project
DEBUG_LOG_DIR=log_folder

# Auto clean logs
DEBUG_AUTO_CLEAN_ENABLED=True
DEBUG_CLEAN_ON_START=True
DEBUG_CLEAN_AFTER_WRITE=True
DEBUG_CLEAN_CHECK_INTERVAL_SECONDS=3600
DEBUG_LOG_RETENTION=3 months

# Critical notify — включать только после настройки каналов
DEBUG_CRITICAL_NOTIFY_ENABLED=False
DEBUG_CRITICAL_NOTIFY_COOLDOWN_SECONDS=60
# Каналы критик-уведомлений: "all" | "telegram" | "email" | "webhook" | "none"
DEBUG_CRITICAL_NOTIFY_CHANNEL=none

# Telegram
DEBUG_CRITICAL_NOTIFY_TELEGRAM=False
DEBUG_TELEGRAM_BOT_TOKEN=
DEBUG_TELEGRAM_CHAT_ID=

# Email SMTP
DEBUG_CRITICAL_NOTIFY_EMAIL=False
DEBUG_SMTP_HOST=smtp.gmail.com
DEBUG_SMTP_PORT=587
DEBUG_SMTP_USE_TLS=True
DEBUG_SMTP_USERNAME=
DEBUG_SMTP_PASSWORD=
DEBUG_EMAIL_FROM=
DEBUG_EMAIL_TO=

# Webhook
DEBUG_CRITICAL_NOTIFY_WEBHOOK=False
DEBUG_CRITICAL_WEBHOOK_URL=

# Timeout
DEBUG_CRITICAL_NOTIFY_TIMEOUT_SECONDS=8
