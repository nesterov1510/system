# ── MSB — продакшн-окружение ─────────────────────────────────────
# Скопируйте в /home/windowrepair-ae/msb/.env и заполните секреты.

# --- БД ---
POSTGRES_USER=msb
POSTGRES_PASSWORD=ЗАМЕНИТЕ_НА_СЛОЖНЫЙ_ПАРОЛЬ
POSTGRES_DB=msb

# Строка подключения к PostgreSQL (установленному отдельно или в Docker).
DATABASE_URL=postgresql+asyncpg://msb:ЗАМЕНИТЕ_НА_СЛОЖНЫЙ_ПАРОЛЬ@localhost:5432/msb

# --- API (бэкенд) ---
ENV=prod
SECRET_KEY=ЗАМЕНИТЕ_НА_ДЛИННУЮ_СЛУЧАЙНУЮ_СТРОКУ_НЕ_МЕНЕЕ_32_СИМВОЛОВ
# Команда для генерации: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Адрес фронтенда для QR-кода на бланках.
PUBLIC_BASE_URL=http://192.168.8.81:3030

# --- Web (Next.js) ---
# Пустые = web сам проксирует /api и /ws на localhost:8085 (см. next.config.mjs).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# --- Seed (первый запуск, потом можно удалить или сменить) ---
SEED_ADMIN_EMAIL=admin@msb.local
SEED_ADMIN_PASSWORD=CHANGE_ME_before_first_start

# --- print-agent (на этом же сервере или на ПК в LAN) ---
MSB_API_URL=http://192.168.8.81:8085
MSB_EMAIL=admin@msb.local
MSB_PASSWORD=CHANGE_ME_set_to_admin_password
MSB_PRINT_CMD=lp -d EPSON_L3250 {file}