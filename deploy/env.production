# MSB — шаблон production-окружения для native/systemd deployment.
# Скопируйте в /home/windowrepair-ae/msb/.env, замените ВСЕ CHANGE_ME и:
#   chmod 600 /home/windowrepair-ae/msb/.env
# Полная инструкция: /home/windowrepair-ae/msb/DEPLOY.md

# --- PostgreSQL (только localhost:5432) ---
POSTGRES_USER=msb
# Используйте URL-безопасный пароль, например: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD_URL_SAFE
POSTGRES_DB=msb
DATABASE_URL=postgresql+asyncpg://msb:CHANGE_ME_DB_PASSWORD_URL_SAFE@127.0.0.1:5432/msb

# --- FastAPI ---
ENV=prod
# Сгенерировать: openssl rand -hex 48
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
PUBLIC_BASE_URL=http://192.168.8.81:3030
CORS_ORIGINS='["http://192.168.8.81:3030","http://192.168.8.81:8085"]'
STORAGE_MODE=local
UPLOAD_DIR=/home/windowrepair-ae/msb/apps/api/uploads

# --- Next.js ---
# Оставьте пустыми: браузер использует same-origin, а Web проксирует запросы
# на API по 127.0.0.1:8085 (см. apps/web/next.config.mjs).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# --- Seed: используется только при первом старте пустой БД ---
SEED_ADMIN_EMAIL=admin@msb.local
SEED_ADMIN_PASSWORD=CHANGE_ME_UNIQUE_ADMIN_PASSWORD
SEED_ADMIN_PHONE=+99300000000

# --- Print-agent на том же сервере (служба опциональна) ---
# Для агента на другом компьютере: http://192.168.8.81:8085
MSB_API_URL=http://127.0.0.1:8085
MSB_EMAIL=admin@msb.local
MSB_PASSWORD=CHANGE_ME_TO_MSB_USER_PASSWORD
MSB_PRINT_CMD='lp -d EPSON_L3250 {file}'
MSB_POLL_SECONDS=3
MSB_SAVE_DIR=/home/windowrepair-ae/msb/apps/print-agent/printed
