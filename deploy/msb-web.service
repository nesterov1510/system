# /etc/systemd/system/msb-web.service
# MSB Next.js standalone frontend: /home/windowrepair-ae/msb, port 3030.
# Build and installation are documented in DEPLOY.md.

[Unit]
Description=MSB Web (Next.js frontend)
After=network-online.target msb-api.service
Wants=network-online.target msb-api.service

[Service]
Type=simple
User=windowrepair-ae
Group=windowrepair-ae
WorkingDirectory=/home/windowrepair-ae/msb/apps/web
EnvironmentFile=/home/windowrepair-ae/msb/.env

ExecStart=/usr/bin/node /home/windowrepair-ae/msb/apps/web/.next/standalone/server.js

Environment=NODE_ENV=production
Environment=PORT=3030
Environment=HOSTNAME=0.0.0.0

Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
UMask=0027

NoNewPrivileges=true
ProtectHome=false
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
