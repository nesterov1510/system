# MSB — окружение ПУБЛИЧНОГО сервера (вторая машина, только страница клиента).
# Скопируйте в /home/windowrepair-ae/msb/.env.public, замените CHANGE_ME и:
#   chmod 600 /home/windowrepair-ae/msb/.env.public
#
# Базы данных на этой машине нет и быть не должно: статус ремонта берётся
# у внутреннего сервера по HTTP.

ENV=prod

# --- Только клиентская часть ---
# Отдавать наружу лишь /r/{token}, /api/public/*, CSS страницы и /health.
PUBLIC_ONLY=true
# Внутренний сервер (первая машина, локальная сеть).
PUBLIC_UPSTREAM_URL=http://192.168.8.81:8085
# Адрес ЭТОЙ машины, каким его видит клиент: на него ведёт QR в бланке.
# Ставится в .env ВНУТРЕННЕГО сервера (CLIENT_BASE_URL), а не только здесь.
CLIENT_BASE_URL=http://CHANGE_ME_IP_ЭТОЙ_МАШИНЫ:8086

# --- База данных не нужна ---
# Строка нужна только потому, что модуль конфигурации её читает; соединения
# не будет. Можно оставить как есть.
DATABASE_URL=postgresql+asyncpg://unused:unused@127.0.0.1:1/unused

# --- Секреты ---
# Свой ключ (openssl rand -hex 48). Совпадать с внутренним не обязан:
# сессий и подписанных токенов этот экземпляр не создаёт.
SECRET_KEY=CHANGE_ME_openssl_rand_hex_48

# --- Фоновые задачи внутреннего сервера здесь не нужны ---
REMINDER_ENABLED=false
SMS_ENABLED=false

# --- Прочее ---
STORAGE_MODE=local
UPLOAD_DIR=/home/windowrepair-ae/msb/apps/api/uploads
