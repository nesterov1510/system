# /etc/systemd/system/msb-api.service
# MSB FastAPI backend: /home/windowrepair-ae/msb, port 8085.
# Installation is documented in DEPLOY.md.

[Unit]
Description=MSB API (FastAPI backend)
# PostgreSQL may be an existing system service or a container on 5432.
# Restart=on-failure below handles a short database startup race.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=windowrepair-ae
Group=windowrepair-ae
WorkingDirectory=/home/windowrepair-ae/msb/apps/api
EnvironmentFile=/home/windowrepair-ae/msb/.env
Environment=PYTHONUNBUFFERED=1

# Один worker выбран намеренно: при lifespan приложение создаёт/обновляет схему
# и выполняет seed. Несколько workers могут конкурировать при первом старте.
ExecStart=/home/windowrepair-ae/msb/apps/api/.venv/bin/uvicorn app.main:app \
    --host 0.0.0.0 \
    --port 8085 \
    --workers 1 \
    --log-level info

Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30
UMask=0027

NoNewPrivileges=true
ProtectHome=false
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
