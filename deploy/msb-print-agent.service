# /etc/systemd/system/msb-print-agent.service
# Systemd unit для print-agent (опрос очереди печати).
# Расположение: /home/windowrepair-ae/msb/apps/print-agent
#
# Может работать как на сервере, так и на отдельном ПК (у принтера).
# На ПК замените MSB_API_URL на http://192.168.8.81:8085.
#
# Установка:
#   sudo cp deploy/msb-print-agent.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now msb-print-agent

[Unit]
Description=MSB Print Agent (printer queue poller)
After=network.target msb-api.service
Wants=msb-api.service

[Service]
Type=simple
User=windowrepair-ae
Group=windowrepair-ae
WorkingDirectory=/home/windowrepair-ae/msb/apps/print-agent

EnvironmentFile=/home/windowrepair-ae/msb/.env
Environment=MSB_API_URL=http://192.168.8.81:8085
Environment=MSB_EMAIL=operator@msb.local
Environment=MSB_PASSWORD=operator123
Environment=MSB_PRINT_CMD=lp -d EPSON_L3250 {file}
Environment=MSB_POLL_SECONDS=3
Environment=MSB_SAVE_DIR=./printed

ExecStart=/home/windowrepair-ae/msb/apps/print-agent/.venv/bin/python agent.py

Restart=always
RestartSec=5

NoNewPrivileges=true
ProtectHome=false
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target