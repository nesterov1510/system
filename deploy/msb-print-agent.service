# /etc/systemd/system/msb-print-agent.service
# Optional MSB print queue agent. Configure CUPS and .env before enabling it;
# see DEPLOY.md. All MSB_* values come from the root .env file.

[Unit]
Description=MSB Print Agent (printer queue poller)
After=network-online.target msb-api.service cups.service
Wants=network-online.target msb-api.service

[Service]
Type=simple
User=windowrepair-ae
Group=windowrepair-ae
WorkingDirectory=/home/windowrepair-ae/msb/apps/print-agent
EnvironmentFile=/home/windowrepair-ae/msb/.env
Environment=PYTHONUNBUFFERED=1

ExecStart=/home/windowrepair-ae/msb/apps/print-agent/.venv/bin/python agent.py

Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
UMask=0027

NoNewPrivileges=true
ProtectHome=false
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
