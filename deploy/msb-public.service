# /etc/systemd/system/msb-public.service
# Публичный экземпляр MSB: отдаёт в интернет ТОЛЬКО страницу клиента /r/{token}.
# Полный интерфейс продолжает работать на msb-api.service (127.0.0.1:8085).
#
#   sudo cp deploy/msb-public.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now msb-public
#
# Переменные PUBLIC_ONLY и CLIENT_BASE_URL берутся из того же .env, поэтому
# в нём должны быть строки (см. deploy/env.production):
#   PUBLIC_ONLY=true        — но только если этот .env читает публичный экземпляр!
#
# ВАЖНО: один и тот же .env нельзя давать обоим экземплярам — внутренний
# экземпляр с PUBLIC_ONLY=true тоже перестанет отдавать админку. Либо держите
# отдельный файл (ниже Environment= переопределяет EnvironmentFile), либо
# поднимайте публичный экземпляр на другой машине/контейнере.

[Unit]
Description=MSB public client page (only /r/{token})
After=network-online.target msb-api.service
Wants=network-online.target

[Service]
Type=simple
User=windowrepair-ae
Group=windowrepair-ae
WorkingDirectory=/home/windowrepair-ae/msb/apps/api
EnvironmentFile=/home/windowrepair-ae/msb/.env
# Переопределяем после EnvironmentFile: этот экземпляр — только клиентский.
Environment=PUBLIC_ONLY=true
Environment=PYTHONUNBUFFERED=1

ExecStart=/home/windowrepair-ae/msb/apps/api/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8086 \
    --workers 1 \
    --log-level info

Restart=on-failure
RestartSec=5
TimeoutStartSec=120
UMask=0027
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
