# /etc/systemd/system/msb-public.service — ВТОРАЯ машина (публичная).
# Отдаёт в интернет только страницу клиента /r/{token}. Базы данных здесь нет:
# статус ремонта берётся у внутреннего сервера по HTTP (PUBLIC_UPSTREAM_URL).
#
#   sudo cp deploy/msb-public.service /etc/systemd/system/
#   sudo cp deploy/env.public /home/windowrepair-ae/msb/.env.public   # и заполнить
#   sudo systemctl daemon-reload && sudo systemctl enable --now msb-public
#
# Отдельный файл окружения обязателен: общий .env с внутренним сервером давать
# нельзя — там DATABASE_URL и PUBLIC_ONLY=false.

[Unit]
Description=MSB public client page (only /r/{token}, no database)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=windowrepair-ae
Group=windowrepair-ae
WorkingDirectory=/home/windowrepair-ae/msb/apps/api
EnvironmentFile=/home/windowrepair-ae/msb/.env.public
Environment=PYTHONUNBUFFERED=1

# Слушаем только loopback: наружу выпускает nginx (deploy/nginx-public.conf)
# или Cloudflare Tunnel (deploy/cloudflared-config.yml). Еслиreverse-прокси нет
# и порт открывается напрямую — поставьте --host 0.0.0.0 и закройте всё лишнее
# файрволом.
ExecStart=/home/windowrepair-ae/msb/apps/api/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8086 \
    --workers 1 \
    --log-level info

Restart=on-failure
RestartSec=5
TimeoutStartSec=120
UMask=0027
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
