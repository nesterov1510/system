# ── RemontFlow — копируйте в `.env` и заполните ─────────────────────────
# Секреты живут ТОЛЬКО в env. Никогда не коммитьте реальный .env.

# --- БД ---
POSTGRES_USER=remontflow
POSTGRES_PASSWORD=remontflow
POSTGRES_DB=remontflow

# --- API ---
# ВАЖНО: замените на длинную случайную строку (>= 32 символа):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_to_a_long_random_secret_0123456789

# Публичный базовый URL для QR-ссылок на бланке
PUBLIC_BASE_URL=http://localhost:8000

# CORS: origin фронтенда
WEB_ORIGIN=http://localhost:3000

# --- Seed (первый запуск) ---
SEED_ADMIN_EMAIL=admin@remontflow.local
SEED_ADMIN_PASSWORD=admin123

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# --- print-agent (см. apps/print-agent/agent.py) ---
REMONTFLOW_API_URL=http://localhost:8000
REMONTFLOW_EMAIL=operator@remontflow.local
REMONTFLOW_PASSWORD=operator123
# Linux/CUPS:  lp -d EPSON_L3250 {file}
# Windows:     powershell -Command "Start-Process -FilePath '{file}' -Verb Print"
REMONTFLOW_PRINT_CMD=lp -d EPSON_L3250 {file}
