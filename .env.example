# ── MSB (Мастер Сервис Бюро) — копируйте в `.env` и заполните ─────────────────────────
# Секреты живут ТОЛЬКО в env. Никогда не коммитьте реальный .env.

# --- БД ---
POSTGRES_USER=msb
POSTGRES_PASSWORD=msb
POSTGRES_DB=msb

# --- API ---
# ВАЖНО: замените на длинную случайную строку (>= 32 символа):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_to_a_long_random_secret_0123456789

# ── ЛОКАЛЬНАЯ СЕТЬ ──────────────────────────────────────────────────────
# IP-адрес машины, где крутится система (узнать: `ip addr` / `ipconfig`).
# Пример: http://192.168.1.10:3000
#
# PUBLIC_BASE_URL — адрес, куда ведёт QR-код на бланке (страница /r/{token}
# живёт на ФРОНТЕНДЕ, порт 3000). Для работы с телефонов укажите IP машины.
PUBLIC_BASE_URL=http://192.168.1.10:3000

# --- Web (Next.js) ---
# Оставьте ПУСТЫМИ — тогда фронтенд сам проксирует /api и /ws на backend
# на этой же машине (это удобнее для локальной сети, не нужен CORS).
# Задавать явно нужно только если backend на ДРУГОЙ машине.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# --- Seed (первый запуск) ---
SEED_ADMIN_EMAIL=admin@msb.local
SEED_ADMIN_PASSWORD=admin123

# --- print-agent (см. apps/print-agent/agent.py) ---
# Если print-agent на ТОЙ ЖЕ машине, что и backend — оставьте localhost.
# Если на другой машине в LAN — укажите IP машины с backend.
MSB_API_URL=http://192.168.1.10:8000
MSB_EMAIL=operator@msb.local
MSB_PASSWORD=operator123
# Linux/CUPS:  lp -d EPSON_L3250 {file}
# Windows:     powershell -Command "Start-Process -FilePath '{file}' -Verb Print"
MSB_PRINT_CMD=lp -d EPSON_L3250 {file}
