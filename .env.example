# ── MSB — копируйте в .env и заполните ───────────────────────────
# Секреты живут ТОЛЬКО в env. Никогда не коммитьте реальный .env.

# --- БД ---
POSTGRES_USER=msb
POSTGRES_PASSWORD=msb
POSTGRES_DB=msb

# --- API ---
# ВАЖНО: замените на длинную случайную строку (>= 32 символа):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ENV=prod
SECRET_KEY=change_me_to_a_long_random_secret_0123456789

# PUBLIC_BASE_URL — адрес, куда ведёт QR-код на бланке (страница /r/{token}
# живёт на ФРОНТЕНДЕ). Для работы в локальной сети укажите IP сервера.
PUBLIC_BASE_URL=http://192.168.8.81:3030

# --- Web (Next.js) ---
# Оставьте ПУСТЫМИ — тогда фронтенд сам проксирует /api и /ws на backend
# на этой же машине (это удобнее для локальной сети, не нужен CORS).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# --- Seed (первый запуск) ---
SEED_ADMIN_EMAIL=admin@msb.local
SEED_ADMIN_PASSWORD=CHANGE_ME_before_first_start

# --- SMS-шлюз ---
# Секреты берутся ТОЛЬКО отсюда (или из «Админ → SMS», хранится в БД).
# В исходном коде боевых логина/пароля нет и быть не должно.
# Пустые значения = SMS выключены, отправка вернёт {"ok": false}.
SMS_GATEWAY_URL=
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
# true — проверять сертификат шлюза. Ставьте false только для
# самоподписанного сертификата в доверенной внутренней сети.
SMS_VERIFY_SSL=true

# --- Ежедневные напоминания «заберите технику» ---
# После «Ремонт закончен» клиент раз в сутки получает SMS с просьбой забрать
# технику (текст — шаблон pickup_reminder в «Админ → SMS»). Рассылка идёт, пока
# ремонт в статусах «Готово к выдаче» / «Не забрано»; после выдачи прекращается.
REMINDER_ENABLED=true
# Как часто фоновая задача проверяет очередь (минуты).
REMINDER_CHECK_INTERVAL_MIN=15
# Периодичность напоминаний одному клиенту (часы). 24 = раз в сутки.
REMINDER_EVERY_HOURS=24
# Первое напоминание — через столько часов после готовности (в тот же день
# клиент уже получил SMS «ремонт готов»).
REMINDER_FIRST_DELAY_HOURS=24
# Тихие часы: не будим клиента ночью (время местное, Asia/Ashgabat).
REMINDER_SEND_FROM_HOUR=9
REMINDER_SEND_TO_HOUR=20
REMINDER_TIMEZONE=Asia/Ashgabat
# 0 = напоминать, пока технику не заберут. Иначе — не больше N напоминаний.
REMINDER_MAX_COUNT=0

# --- print-agent (см. apps/print-agent/agent.py) ---
MSB_API_URL=http://192.168.8.81:8085
MSB_EMAIL=admin@msb.local
MSB_PASSWORD=CHANGE_ME_set_to_admin_password
# Linux/CUPS:  lp -d EPSON_L3250 {file}
# Windows:     powershell -Command "Start-Process -FilePath '{file}' -Verb Print"
MSB_PRINT_CMD=lp -d EPSON_L3250 {file}